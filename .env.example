# Turso (libsql)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Alpaca (paper mode) — equities/crypto quotes+bars, options indicative feed, movers screener
ALPACA_API_KEY=your-alpaca-key
ALPACA_SECRET_KEY=your-alpaca-secret
ALPACA_PAPER=true

# OANDA (forex paper/practice trading) — Phase 15
# OANDA_API_KEY=your-oanda-practice-api-key
# OANDA_ACCOUNT_ID=your-oanda-practice-account-id

# LLM providers (all free tiers)
GROQ_API_KEY=your-groq-key
CEREBRAS_API_KEY=your-cerebras-key
OPENROUTER_API_KEY=your-openrouter-key

# Cron + admin auth (self-set secret)
CRON_SECRET=your-random-secret

# Alpha Vantage — economic calendar (free tier: 25 req/day)
ALPHA_VANTAGE_KEY=your-alphavantage-key

# Finnhub — forex rates, earnings calendar, symbol search (free tier: 60 req/min)
# FINNHUB_API_KEY=your-finnhub-key

# Web push notifications (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# Premium TTS (optional — StreamElements is the free default)
# ELEVENLABS_API_KEY=your-elevenlabs-key
# ELEVENLABS_VOICE_ID=your-voice-id

# Optional overrides
# ACCOUNT_EQUITY=10000                     # council/orchestrator equity assumption
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
